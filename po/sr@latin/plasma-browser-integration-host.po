#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Nemanja Hiršl"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "nemhirsl@gmail.com"

#: downloadjob.cpp:147
#, kde-format
msgid ""
"This type of file can harm your computer. If you want to keep it, accept "
"this download from the browser window."
msgstr ""
"Ovaj tip fajla može da naudi računaru. Ako želite da ga zadržite, prihvatite "
"ovo preuzimanje u prozoru pregledača."

#: downloadjob.cpp:244
#, kde-format
msgid "Access denied."
msgstr "Pristup je odbijen."

#: downloadjob.cpp:245
#, kde-format
msgid "Insufficient free space."
msgstr "Nema dovoljno slobodnog prostora."

#: downloadjob.cpp:246
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "Ime fajla koje ste izabrali je predugačko."

#: downloadjob.cpp:247
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "Fajl je prevelik za preuzimanje."

#: downloadjob.cpp:249
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "Fajl možda ima zlonameran sadržaj."

#: downloadjob.cpp:250
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "Došlo je do privremene greške. Pokušajte ponovo kasnije."

#: downloadjob.cpp:252
#, kde-format
msgid "A network error has occurred."
msgstr "Došlo je do mrežne greške."

#: downloadjob.cpp:253
#, kde-format
msgid "The network operation timed out."
msgstr "Isteklo je vreme za mrežni postupak."

#: downloadjob.cpp:254
#, kde-format
msgid "The network connection has been lost."
msgstr "Mrežna veza je izgubljena."

#: downloadjob.cpp:255
#, kde-format
msgid "The server is no longer reachable."
msgstr "Server više nije dostupan."

#: downloadjob.cpp:257
#, kde-format
msgid "A server error has occurred."
msgstr "Došlo je do greške servera."

#: downloadjob.cpp:261
#, kde-format
msgid "The server does not have the requested data."
msgstr "Server nema zahtevane podatke."

#: downloadjob.cpp:263
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "Pregledač se neočekivano zatvorio."

#: downloadjob.cpp:269
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "Došlo je do nepoznate greške tokom preuzimanja."

#: downloadjob.cpp:307
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "Preuzimanje"

#: downloadjob.cpp:308
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "Izvor"

#: downloadjob.cpp:309
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "Odredište"

#: historyrunnerplugin.cpp:108
#, kde-format
msgctxt "Dummy search result"
msgid "Additional permissions are required"
msgstr "Potrebne su dodatne dozvole"

#: tabsrunnerplugin.cpp:38
#, kde-format
msgid "Mute Tab"
msgstr "Utišaj jezičak"

#: tabsrunnerplugin.cpp:43
#, kde-format
msgid "Unmute Tab"
msgstr "Vrati zvuk jezička"
