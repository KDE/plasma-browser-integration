#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "ئابدۇقادىر ئابلىز، غەيرەت كەنجى"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "sahranbay@gmail.com, gheyret@gmail.com"

#: downloadjob.cpp:147
#, kde-format
msgid ""
"This type of file can harm your computer. If you want to keep it, accept "
"this download from the browser window."
msgstr ""
"بۇ خىل ھۆججەت كومپيۇتېرىڭىزغا خەۋپ كەلتۈرۈشى مۇمكىن. ئۇنى چوقۇم ساقلاپ "
"قالماقچى بولسىڭىز، توركۆرگۈ كۆزنىكىدىن چۈشۈرۈشكە قوشۇلۇڭ."

#: downloadjob.cpp:244
#, kde-format
msgid "Access denied."
msgstr "زىيارەت رەت قىلىندى."

#: downloadjob.cpp:245
#, kde-format
msgid "Insufficient free space."
msgstr "بىكار بوشلۇق يېتەرلىك ئەمەس."

#: downloadjob.cpp:246
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "سىز تاللىغان ھۆججەت ئاتى بەك ئۇزۇن."

#: downloadjob.cpp:247
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "ھۆججەت بەك چوڭ، چۈشۈرگىلى بولمايدۇ."

#: downloadjob.cpp:249
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "ھۆججەتتە زەھەرخەندە مەزمۇن بولۇشى مۇمكىن."

#: downloadjob.cpp:250
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "ۋاقىتلىق خاتالىق كۆرۈلدى. كېيىن قايتا سىناڭ."

#: downloadjob.cpp:252
#, kde-format
msgid "A network error has occurred."
msgstr "تور خاتالىقى كۆرۈلدى."

#: downloadjob.cpp:253
#, kde-format
msgid "The network operation timed out."
msgstr "تور مەشغۇلاتىنىڭ ۋاقتى ئۆتتى."

#: downloadjob.cpp:254
#, kde-format
msgid "The network connection has been lost."
msgstr "تور باغلىنىشى ئۈزۈلدى."

#: downloadjob.cpp:255
#, kde-format
msgid "The server is no longer reachable."
msgstr "ئەمدى مۇلازىمېتىرنى زىيارەت قىلغىلى بولمايدۇ."

#: downloadjob.cpp:257
#, kde-format
msgid "A server error has occurred."
msgstr "مۇلازىمېتىر خاتالىقى كۆرۈلدى."

#: downloadjob.cpp:261
#, kde-format
msgid "The server does not have the requested data."
msgstr "مۇلازىمېتىردا ئىلتىماس قىلىنغان ئۇچۇر يوق."

#: downloadjob.cpp:263
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "توركۆرگۈ پىروگراممىسى تاسادىپىي يېپىلدى."

#: downloadjob.cpp:269
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "چۈشۈرۈۋاتقاندا نامەلۇم خاتالىق يۈز بەردى."

#: downloadjob.cpp:307
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "چۈشۈرۈۋاتىدۇ"

#: downloadjob.cpp:308
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "مەنبە"

#: downloadjob.cpp:309
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "نىشان"

#: historyrunnerplugin.cpp:108
#, kde-format
msgctxt "Dummy search result"
msgid "Additional permissions are required"
msgstr "قوشۇمچە ئىجازەت زۆرۈر"

#: tabsrunnerplugin.cpp:38
#, kde-format
msgid "Mute Tab"
msgstr "بەتكۈچ ئۈنسىز"

#: tabsrunnerplugin.cpp:43
#, kde-format
msgid "Unmute Tab"
msgstr "بەتكۈچ ئۈنلۈك"
