#, kde-format
msgctxt "NAME OF TRANSLATORS"
msgid "Your names"
msgstr "Guðmundur Erlingsson"

#, kde-format
msgctxt "EMAIL OF TRANSLATORS"
msgid "Your emails"
msgstr "gudmundure@gmail.com"

#: downloadjob.cpp:147
#, kde-format
msgid ""
"This type of file can harm your computer. If you want to keep it, accept "
"this download from the browser window."
msgstr ""
"Skrá af þessari gerð getur skaðað tölvuna þína. Ef þú vilt halda henni "
"skaltu samþykkja þetta niðurhal í vafraglugganum."

#: downloadjob.cpp:244
#, kde-format
msgid "Access denied."
msgstr "Aðgangi hafnað."

#: downloadjob.cpp:245
#, kde-format
msgid "Insufficient free space."
msgstr "Ekki nóg diskpláss."

#: downloadjob.cpp:246
#, kde-format
msgid "The file name you have chosen is too long."
msgstr "Skráarheitið sem þú valdir er of langt."

#: downloadjob.cpp:247
#, kde-format
msgid "The file is too large to be downloaded."
msgstr "Skráin er of stór til að hægt sé að sækja hana."

#: downloadjob.cpp:249
#, kde-format
msgid "The file possibly contains malicious contents."
msgstr "Skráin inniheldur hugsanlega skaðlegt efni."

#: downloadjob.cpp:250
#, kde-format
msgid "A temporary error has occurred. Please try again later."
msgstr "Tímabundin villa kom upp. Reyndu aftur síðar."

#: downloadjob.cpp:252
#, kde-format
msgid "A network error has occurred."
msgstr "Netvilla kom upp."

#: downloadjob.cpp:253
#, kde-format
msgid "The network operation timed out."
msgstr "Netaðgerðin rann út á tíma."

#: downloadjob.cpp:254
#, kde-format
msgid "The network connection has been lost."
msgstr "Nettengingin brást."

#: downloadjob.cpp:255
#, kde-format
msgid "The server is no longer reachable."
msgstr "Ekki næst lengur í þjóninn."

#: downloadjob.cpp:257
#, kde-format
msgid "A server error has occurred."
msgstr "Þjónsvilla kom upp."

#: downloadjob.cpp:261
#, kde-format
msgid "The server does not have the requested data."
msgstr "Þjónninn er ekki með umbeðin gögn."

#: downloadjob.cpp:263
#, kde-format
msgid "The browser application closed unexpectedly."
msgstr "Vafraforritið lokaðist óvænt."

#: downloadjob.cpp:269
#, kde-format
msgid "An unknown error occurred while downloading."
msgstr "Óþekkt villa kom upp við niðurhal."

#: downloadjob.cpp:307
#, kde-format
msgctxt "Job heading, like 'Copying'"
msgid "Downloading"
msgstr "Sæki"

#: downloadjob.cpp:308
#, kde-format
msgctxt "The URL being downloaded"
msgid "Source"
msgstr "Uppruni"

#: downloadjob.cpp:309
#, kde-format
msgctxt "The location being downloaded to"
msgid "Destination"
msgstr "Áfangastaður"

#: historyrunnerplugin.cpp:108
#, kde-format
msgctxt "Dummy search result"
msgid "Additional permissions are required"
msgstr "Viðbótarheimilda er krafist"

#: tabsrunnerplugin.cpp:38
#, kde-format
msgid "Mute Tab"
msgstr "Þagga flipa"

#: tabsrunnerplugin.cpp:43
#, kde-format
msgid "Unmute Tab"
msgstr "Afþagga flipa"
